# ==============================================================================
# Food Roulette — Environment Configuration
# Copy this file to .env and fill in the required values.
# ==============================================================================

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Food Roulette"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# External API Mode: "mock" (no API keys required, clearly labeled in UI) or "live"
EXTERNAL_API_MODE="mock"
NEXT_PUBLIC_EXTERNAL_API_MODE="mock"

# Database (PostgreSQL 16 + PostGIS)
DATABASE_URL="postgresql://food_roulette:food_roulette_dev@localhost:5432/food_roulette?schema=public"

# Authentication (Used in Phase 5 — generate a strong 32+ char secret in production)
AUTH_JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
AUTH_COOKIE_NAME="fr_session"

# Google APIs (Server-side Places API key MUST NEVER be exposed to NEXT_PUBLIC_*)
GOOGLE_PLACES_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Rate Limiting & Cost Control
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="60"
PLACES_CACHE_TTL_SECONDS="900"
