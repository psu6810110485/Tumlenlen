generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  USER
  ADMIN
}

enum PriceTier {
  BUDGET    // <= 100 THB
  MODERATE  // 101 - 300 THB
  PREMIUM   // > 300 THB
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  LATE_NIGHT
  SNACK
}

enum DataSource {
  INTERNAL
  GOOGLE_PLACES
  MOCK
}

enum MenuVerificationStatus {
  VERIFIED  // Confirmed evidence that the restaurant serves this menu
  INFERRED  // System-inferred from name/category/keywords; clearly badged in UI
}

// =============================================================================
// 1. Users
// =============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  displayName   String    @map("display_name") @db.VarChar(120)
  avatarUrl     String?   @map("avatar_url") @db.Text
  role          UserRole  @default(USER)
  pdpaConsentAt DateTime? @map("pdpa_consent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  reviews             Review[]
  favorites           Favorite[]
  randomHistory       RandomHistory[]
  passwordResetTokens PasswordResetToken[]

  @@index([createdAt])
  @@map("users")
}

// =============================================================================
// 1b. Password Reset Tokens (SHA-256 Hashed, Single-Use, Expiring)
// =============================================================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// =============================================================================
// 2. Categories
// =============================================================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  nameTh    String   @map("name_th") @db.VarChar(120)
  nameEn    String   @map("name_en") @db.VarChar(120)
  icon      String   @db.VarChar(32)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  menus Menu[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

// =============================================================================
// 3. Menus
// =============================================================================

model Menu {
  id             String     @id @default(uuid()) @db.Uuid
  categoryId     String     @map("category_id") @db.Uuid
  slug           String     @unique @db.VarChar(120)
  nameTh         String     @map("name_th") @db.VarChar(160)
  nameEn         String     @map("name_en") @db.VarChar(160)
  descriptionTh  String     @map("description_th") @db.Text
  imageUrl       String?    @map("image_url") @db.Text
  minPrice       Int        @map("min_price")
  maxPrice       Int        @map("max_price")
  priceTier      PriceTier  @map("price_tier")
  mealTypes      MealType[] @map("meal_types")
  searchKeywords String[]   @map("search_keywords")
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  restaurantMenus RestaurantMenu[]
  randomHistory   RandomHistory[]

  @@index([categoryId, isActive])
  @@index([priceTier, isActive])
  @@index([minPrice, maxPrice])
  @@map("menus")
}

// =============================================================================
// 4. Restaurants (with PostGIS Geography Point & GiST Spatial Index)
// =============================================================================

model Restaurant {
  id                String                                  @id @default(uuid()) @db.Uuid
  googlePlaceId     String?                                 @unique @map("google_place_id") @db.VarChar(255)
  name              String                                  @db.VarChar(200)
  address           String                                  @db.Text
  province          String?                                 @db.VarChar(120)
  district          String?                                 @db.VarChar(120)
  latitude          Float
  longitude         Float
  location          Unsupported("geography(Point, 4326)")?
  phone             String?                                 @db.VarChar(40)
  priceLevel        Int?                                    @map("price_level") // 1-4 scale
  estimatedMinPrice Int?                                    @map("estimated_min_price")
  estimatedMaxPrice Int?                                    @map("estimated_max_price")
  googleRating      Float?                                  @map("google_rating")
  googleReviewCount Int                                     @default(0) @map("google_review_count")
  appRatingAvg      Float?                                  @map("app_rating_avg")
  appReviewCount    Int                                     @default(0) @map("app_review_count")
  openingHours      Json?                                   @map("opening_hours")
  photoUrls         String[]                                @map("photo_urls")
  grabFoodUrl       String?                                 @map("grab_food_url") @db.Text // Verified direct URL only
  lineManUrl        String?                                 @map("line_man_url") @db.Text  // Verified direct URL only
  dataSource        DataSource                              @default(INTERNAL) @map("data_source")
  lastSyncedAt      DateTime?                               @map("last_synced_at")
  createdAt         DateTime                                @default(now()) @map("created_at")
  updatedAt         DateTime                                @updatedAt @map("updated_at")

  restaurantMenus RestaurantMenu[]
  reviews         Review[]
  favorites       Favorite[]

  @@index([location], type: Gist)
  @@index([province, district])
  @@index([googleRating])
  @@index([appRatingAvg])
  @@index([dataSource])
  @@map("restaurants")
}

// =============================================================================
// 5. Restaurant <-> Menu Mapping (Strict Verification Separation)
// =============================================================================

model RestaurantMenu {
  id                 String                 @id @default(uuid()) @db.Uuid
  restaurantId       String                 @map("restaurant_id") @db.Uuid
  menuId             String                 @map("menu_id") @db.Uuid
  price              Int?
  verificationStatus MenuVerificationStatus @default(INFERRED) @map("verification_status")
  evidenceSource     String                 @map("evidence_source") @db.VarChar(255)
  verifiedAt         DateTime?              @map("verified_at")
  isAvailable        Boolean                @default(true) @map("is_available")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, menuId])
  @@index([menuId, verificationStatus, isAvailable])
  @@index([restaurantId, isAvailable])
  @@map("restaurant_menus")
}

// =============================================================================
// 6. Reviews (Food Roulette User Reviews — Strictly Separate from Google)
// =============================================================================

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  rating       Int      // 1 to 5 (enforced by API validation & DB constraint)
  comment      String   @db.Text
  isFlagged    Boolean  @default(false) @map("is_flagged")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("reviews")
}

// =============================================================================
// 7. Favorites
// =============================================================================

model Favorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

// =============================================================================
// 8. Random History
// =============================================================================

model RandomHistory {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  sessionToken    String?  @map("session_token") @db.VarChar(128)
  menuId          String   @map("menu_id") @db.Uuid
  filtersSnapshot Json?    @map("filters_snapshot")
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  menu Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionToken, createdAt(sort: Desc)])
  @@index([menuId])
  @@map("random_history")
}
